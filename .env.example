NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
# Leave empty: the browser reaches the match engine through the same HTTPS
# address as the website (the proxy forwards /socket.io/ to it).
NEXT_PUBLIC_SOCKET_URL=
# Secret key used ONLY by the socket server to write match data (never expose to the browser).
# Get it from Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Origins the match engine accepts socket connections from (comma separated).
# Must include the https address players open (and your WEB_PORT if you changed it).
SOCKET_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:3003,https://localhost:3300

# endpoint for OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318