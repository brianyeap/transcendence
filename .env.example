NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Secret key used ONLY by the socket server to write match data (never expose to the browser).
# Get it from Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Origins the match engine accepts socket connections from (comma separated).
# Must include whatever port `next dev` is actually serving on.
SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3300
