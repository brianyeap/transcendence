# Copy to .env on the server and fill in.

# The server's address. Free option: your public IP with dashes + .sslip.io
# e.g. IP 13.229.10.5 -> 13-229-10-5.sslip.io
SOCKET_DOMAIN=

# Same values as in your .env.local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your Vercel address (no trailing slash). Only these sites may connect.
SOCKET_ALLOWED_ORIGINS=https://your-app.vercel.app
